# === Qwen Models ===
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_qwen_api_key_here

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=3600

# === External APIs ===
AMAP_API_KEY=your_amap_api_key_here

# === NCBI/PubMed (no API key required) ===
NCBI_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# === Observability ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=trinav-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# === TriNav v2 Feature Flags ===
V2_RUNTIME_ENABLED=false
V2_SHADOW_COMPARE_ENABLED=false

# === TriNav v3 Runtime Baseline ===
V3_RUNTIME_ENABLED=true
V3_SHADOW_COMPARE_ENABLED=false
V3_LEGACY_FALLBACK_ENABLED=true
V3_TASK_COORDINATOR_ENABLED=true
V3_BUILTIN_PLUGINS_ENABLED=true
V3_PLUGIN_TRACE_ENABLED=true
V3_PLUGIN_MEDICAL_FOOTER_ENABLED=true

# === TriNav v4 Canary Gates ===
V4_CANARY_ENABLED=false
V4_GATE_MAX_RED_FLAG_MISS_RATE=0.01
V4_GATE_MAX_P95_MS=6000

# === Server Configuration ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
TRINAV_LOG_FILE=logs/trinav.log

# === Timeouts (seconds) ===
LLM_TIMEOUT=30
AMAP_TIMEOUT=5
NCBI_TIMEOUT=10

# === Input and Interaction Constraints ===
MAX_TEXT_LENGTH=2000
MAX_CLARIFICATION_ROUNDS=2
MAX_CLARIFICATION_QUESTIONS=3
